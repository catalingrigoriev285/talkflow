<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="10dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/avatar"
        style="@style/Talkflow.Avatar"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:backgroundTint="#65AADD"
        tools:text="AJ" />

    <View
        android:id="@+id/online_dot"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:background="@drawable/bg_online_dot"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/avatar"
        app:layout_constraintEnd_toEndOf="@id/avatar"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/tf_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/read_status"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Alice Johnson" />

    <ImageView
        android:id="@+id/read_status"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_done_all"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/name"
        app:layout_constraintEnd_toStartOf="@id/time"
        app:layout_constraintTop_toTopOf="@id/name"
        app:tint="@color/tf_read_check"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/tf_text_secondary"
        android:textSize="13sp"
        app:layout_constraintBaseline_toBaselineOf="@id/name"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="12:45" />

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/tf_text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/unread_badge"
        app:layout_constraintStart_toStartOf="@id/name"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_goneMarginEnd="0dp"
        tools:text="See you tomorrow at the office!" />

    <TextView
        android:id="@+id/unread_badge"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingHorizontal="7dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/message"
        tools:backgroundTint="@color/tf_badge"
        tools:text="3" />

    <View
        android:layout_width="0dp"
        android:layout_height="1px"
        android:background="@color/tf_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/name" />
</androidx.constraintlayout.widget.ConstraintLayout>
