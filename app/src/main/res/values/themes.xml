<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Talkflow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <!-- Telegram-style look. Colors switch automatically via values-night/colors.xml. -->
    <style name="Theme.Talkflow" parent="Base.Theme.Talkflow">
        <item name="colorPrimary">@color/tf_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/tf_primary</item>
        <item name="colorSecondary">@color/tf_primary</item>
        <item name="android:colorBackground">@color/tf_background</item>
        <item name="android:windowBackground">@color/tf_background</item>
        <item name="colorSurface">@color/tf_background</item>
        <item name="colorOnSurface">@color/tf_text_primary</item>
        <item name="android:textColorPrimary">@color/tf_text_primary</item>
        <item name="android:textColorSecondary">@color/tf_text_secondary</item>
        <item name="textInputStyle">@style/Widget.Talkflow.TextInput</item>
    </style>

    <!-- Applied to AppBarLayouts with the blue toolbar: white title and icons. -->
    <style name="ThemeOverlay.Talkflow.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="Widget.Talkflow.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/tf_toolbar_subtitle</item>
        <item name="titleTextAppearance">@style/TextAppearance.Talkflow.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Talkflow.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Talkflow.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/tf_primary</item>
        <item name="hintTextColor">@color/tf_primary</item>
        <item name="startIconTint">@color/tf_icon</item>
    </style>

    <style name="Widget.Talkflow.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/tf_primary</item>
        <item name="tint">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Talkflow.Circle</item>
    </style>

    <style name="ShapeAppearance.Talkflow.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Settings rows: icon at 20dp, text at 72dp, like Telegram. -->
    <style name="Talkflow.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">28dp</item>
        <item name="android:drawableTint">@color/tf_icon</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/tf_text_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Talkflow.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tf_primary</item>
    </style>

    <style name="Talkflow.SectionGap" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:background">@color/tf_section_gap</item>
    </style>

    <style name="Talkflow.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Talkflow.InputIcon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="tint">@color/tf_icon</item>
    </style>
</resources>
